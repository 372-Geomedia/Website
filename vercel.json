{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/contact", "destination": "/talk", "permanent": true },
    { "source": "/products/gismaster", "destination": "/products/parcelwise", "permanent": true }
  ]
}
